// admin.js - Versão com debug e auto-criação
let config = { 
    username: '', 
    token: '', 
    repo: 'art-director-portfolio', 
    branch: 'main' 
};

let currentData = { competencies: [], cases: [] };
let selectedCase = null;
let filesToUpload = [];

async function login() {
    const username = document.getElementById('githubUsername').value.trim();
    const token = document.getElementById('githubToken').value.trim();

    if (!username || !token) {
        showAlert('loginAlert', 'Preencha username e token', 'error');
        return;
    }

    config.username = username;
    config.token = token;

    try {
        // Testar token primeiro
        await testToken();
        
        // Tentar carregar config
        try {
            await loadConfig();
        } catch (error) {
            // Se config não existe, criar
            if (error.message.includes('404') || error.message.includes('Not Found')) {
                console.log('Config não encontrado, criando...');
                await createInitialConfig();
                await loadConfig();
            } else {
                throw error;
            }
        }
        
        document.getElementById('loginSection').classList.add('hidden');
        document.getElementById('adminPanel').classList.remove('hidden');
        loadCompetencies();
        loadCases();
        updateCaseSelect();
        showAlert('loginAlert', 'Login realizado com sucesso!', 'success');
        
    } catch (error) {
        console.error('Erro no login:', error);
        let errorMsg = 'Erro: ' + error.message;
        
        if (error.message.includes('401')) {
            errorMsg = 'Token inválido. Verifique se o token está correto e tem permissão "repo".';
        } else if (error.message.includes('404')) {
            errorMsg = 'Repositório não encontrado. Verifique o nome do usuário e do repositório.';
        } else if (error.message.includes('403')) {
            errorMsg = 'Acesso negado. Verifique as permissões do token.';
        }
        
        showAlert('loginAlert', errorMsg, 'error');
    }
}

async function testToken() {
    const response = await fetch('https://api.github.com/user', {
        headers: { 
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json'
        }
    });
    
    if (!response.ok) {
        throw new Error(`Token inválido (${response.status})`);
    }
    
    const user = await response.json();
    console.log('Token válido para:', user.login);
}

async function createInitialConfig() {
    const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/config.json`;
    
    const initialData = {
        competencies: [
            {
                title: "Visual Identity Engineering",
                description: "Brand design focused on longevity, scalability, and technical rigor."
            }
        ],
        cases: []
    };
    
    const body = {
        message: 'Initial config creation',
        content: btoa(JSON.stringify(initialData, null, 2)),
        branch: config.branch
    };

    const response = await fetch(url, {
        method: 'PUT',
        headers: {
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(body)
    });

    if (!response.ok) {
        const error = await response.json();
        throw new Error(`Falha ao criar config: ${error.message}`);
    }
    
    console.log('Config inicial criado com sucesso');
}

async function loadConfig() {
    const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/config.json?ref=${config.branch}`;
    
    console.log('Carregando config de:', url);
    
    const response = await fetch(url, {
        headers: { 
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json'
        }
    });

    if (!response.ok) {
        throw new Error(`Falha ao carregar config (${response.status})`);
    }
    
    const data = await response.json();
    currentData = JSON.parse(atob(data.content));
    console.log('Config carregado:', currentData);
}

async function saveConfig() {
    const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/config.json`;
    
    // Obter SHA atual
    let sha = null;
    try {
        const response = await fetch(url, {
            headers: { 
                'Authorization': `token ${config.token}`,
                'Accept': 'application/vnd.github.v3+json'
            }
        });
        if (response.ok) {
            const data = await response.json();
            sha = data.sha;
        }
    } catch (e) {
        console.error('Erro ao obter SHA:', e);
    }

    const body = {
        message: 'Update config via admin',
        content: btoa(JSON.stringify(currentData, null, 2)),
        branch: config.branch
    };
    
    if (sha) body.sha = sha;

    const response = await fetch(url, {
        method: 'PUT',
        headers: {
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(body)
    });

    if (!response.ok) {
        const error = await response.json();
        throw new Error(`Falha ao salvar: ${error.message}`);
    }
    
    console.log('Config salvo com sucesso');
}

async function loadCompetencies() {
    const list = document.getElementById('competenciesList');
    list.innerHTML = currentData.competencies.map((comp, index) => `
        <div class="item">
            <div class="item-info">
                <h3>${comp.title}</h3>
                <p>${comp.description.substring(0, 100)}${comp.description.length > 100 ? '...' : ''}</p>
            </div>
            <button class="danger" onclick="deleteCompetency(${index})">Remove</button>
        </div>
    `).join('');
}

async function addCompetency() {
    const title = document.getElementById('compTitle').value.trim();
    const description = document.getElementById('compDescription').value.trim();

    if (!title || !description) {
        showAlert('competenciesAlert', 'Preencha todos os campos', 'error');
        return;
    }

    currentData.competencies.push({ title, description });
    
    try {
        await saveConfig();
        document.getElementById('compTitle').value = '';
        document.getElementById('compDescription').value = '';
        loadCompetencies();
        showAlert('competenciesAlert', 'Competência adicionada!', 'success');
    } catch (error) {
        showAlert('competenciesAlert', 'Erro: ' + error.message, 'error');
    }
}

async function deleteCompetency(index) {
    if (!confirm('Confirmar remoção?')) return;
    
    currentData.competencies.splice(index, 1);
    
    try {
        await saveConfig();
        loadCompetencies();
        showAlert('competenciesAlert', 'Removido!', 'success');
    } catch (error) {
        showAlert('competenciesAlert', 'Erro: ' + error.message, 'error');
    }
}

async function loadCases() {
    const list = document.getElementById('casesList');
    list.innerHTML = currentData.cases.map((c, index) => `
        <div class="item">
            <div class="item-info">
                <h3>${c.title}</h3>
                <p>${c.category} — ${c.folder}</p>
            </div>
            <div>
                <button class="secondary" onclick="viewCaseImages(${index})">Images</button>
                <button class="danger" onclick="deleteCase(${index})">Remove</button>
            </div>
        </div>
    `).join('');
}

async function addCase() {
    const title = document.getElementById('caseTitle').value.trim();
    const category = document.getElementById('caseCategory').value.trim();
    const slug = document.getElementById('caseSlug').value.trim().toLowerCase().replace(/\s+/g, '-');

    if (!title || !slug) {
        showAlert('casesAlert', 'Preencha título e slug', 'error');
        return;
    }

    const folder = `img/${slug}`;
    currentData.cases.push({ slug, title, category: category || 'General', folder });

    try {
        await createFolder(folder);
        await saveConfig();
        
        document.getElementById('caseTitle').value = '';
        document.getElementById('caseCategory').value = '';
        document.getElementById('caseSlug').value = '';
        
        loadCases();
        updateCaseSelect();
        showAlert('casesAlert', 'Case adicionado!', 'success');
    } catch (error) {
        showAlert('casesAlert', 'Erro: ' + error.message, 'error');
    }
}

async function createFolder(path) {
    const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/${path}/.gitkeep`;
    
    const response = await fetch(url, {
        method: 'PUT',
        headers: {
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ 
            message: `Create folder ${path}`, 
            content: btoa(''), 
            branch: config.branch 
        })
    });
    
    if (!response.ok && response.status !== 422) { // 422 = já existe
        const error = await response.json();
        throw new Error(`Falha ao criar pasta: ${error.message}`);
    }
}

async function deleteCase(index) {
    if (!confirm('Confirmar remoção do case?')) return;
    
    currentData.cases.splice(index, 1);
    
    try {
        await saveConfig();
        loadCases();
        updateCaseSelect();
        showAlert('casesAlert', 'Case removido!', 'success');
    } catch (error) {
        showAlert('casesAlert', 'Erro: ' + error.message, 'error');
    }
}

function updateCaseSelect() {
    const select = document.getElementById('caseSelect');
    select.innerHTML = '<option value="">Select a case...</option>' +
        currentData.cases.map((c, i) => `<option value="${i}">${c.title}</option>`).join('');

    select.onchange = (e) => {
        if (e.target.value) {
            selectedCase = currentData.cases[e.target.value];
            loadCaseImages();
        }
    };
}

async function loadCaseImages() {
    if (!selectedCase) return;

    const container = document.getElementById('currentImages');
    container.innerHTML = '<h3 style="font-family:Cormorant Garamond,serif;font-size:18px;font-weight:400;margin:30px 0 20px;">Current Images</h3>';

    try {
        const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/${selectedCase.folder}`;
        const response = await fetch(url, {
            headers: { 
                'Authorization': `token ${config.token}`,
                'Accept': 'application/vnd.github.v3+json'
            }
        });

        if (!response.ok) {
            container.innerHTML += '<p style="color:var(--color-text-light);font-size:13px;">No images</p>';
            return;
        }

        const files = await response.json();
        const images = files.filter(f => f.name.match(/\.(jpg|jpeg|png|gif|webp)$/i));

        if (images.length === 0) {
            container.innerHTML += '<p style="color:var(--color-text-light);font-size:13px;">No images</p>';
            return;
        }

        container.innerHTML += images.map(img => `
            <div class="item">
                <div class="item-info">
                    <h3>${img.name}</h3>
                </div>
                <button class="danger" onclick="deleteImage('${img.path}', '${img.sha}')">Remove</button>
            </div>
        `).join('');
    } catch (error) {
        container.innerHTML += '<p style="color:var(--color-text-light);font-size:13px;">Error loading images</p>';
    }
}

async function deleteImage(path, sha) {
    if (!confirm('Remove this image?')) return;

    const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/${path}`;
    
    const response = await fetch(url, {
        method: 'DELETE',
        headers: {
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ 
            message: `Delete ${path}`, 
            sha: sha, 
            branch: config.branch 
        })
    });
    
    if (response.ok) {
        loadCaseImages();
        showAlert('imagesAlert', 'Image removed', 'success');
    } else {
        showAlert('imagesAlert', 'Error removing image', 'error');
    }
}

const uploadArea = document.getElementById('uploadArea');
const fileInput = document.getElementById('fileInput');

uploadArea.addEventListener('click', () => fileInput.click());
uploadArea.addEventListener('dragover', (e) => { 
    e.preventDefault(); 
    uploadArea.style.borderColor = '#1a1a1a'; 
});
uploadArea.addEventListener('dragleave', () => { 
    uploadArea.style.borderColor = 'var(--color-border)'; 
});
uploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.style.borderColor = 'var(--color-border)';
    handleFiles(e.dataTransfer.files);
});

fileInput.onchange = (e) => handleFiles(e.target.files);

function handleFiles(files) {
    filesToUpload = Array.from(files).filter(f => f.type.startsWith('image/'));
    
    const preview = document.getElementById('imagePreview');
    const uploadBtn = document.getElementById('uploadBtn');
    
    preview.innerHTML = filesToUpload.map((file, index) => `
        <div class="image-item">
            <img src="${URL.createObjectURL(file)}">
            <button onclick="removeFile(${index})">&times;</button>
        </div>
    `).join('');
    
    uploadBtn.style.display = filesToUpload.length > 0 ? 'inline-block' : 'none';
}

function removeFile(index) {
    filesToUpload.splice(index, 1);
    handleFiles(filesToUpload);
}

async function uploadImages() {
    if (!selectedCase) {
        showAlert('imagesAlert', 'Select a case first', 'error');
        return;
    }

    if (filesToUpload.length === 0) {
        showAlert('imagesAlert', 'Select files to upload', 'error');
        return;
    }

    showAlert('imagesAlert', 'Uploading images...', 'success');

    for (const file of filesToUpload) {
        const path = `${selectedCase.folder}/${file.name}`;
        try {
            await uploadFile(file, path);
        } catch (error) {
            showAlert('imagesAlert', `Error uploading ${file.name}`, 'error');
        }
    }

    filesToUpload = [];
    document.getElementById('imagePreview').innerHTML = '';
    document.getElementById('uploadBtn').style.display = 'none';
    loadCaseImages();
    showAlert('imagesAlert', 'Images uploaded successfully!', 'success');
}

async function uploadFile(file, path) {
    const url = `https://api.github.com/repos/${config.username}/${config.repo}/contents/${path}`;
    const base64 = await fileToBase64(file);
    const content = base64.split(',')[1];

    const response = await fetch(url, {
        method: 'PUT',
        headers: {
            'Authorization': `token ${config.token}`,
            'Accept': 'application/vnd.github.v3+json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ 
            message: `Upload ${file.name}`, 
            content: content, 
            branch: config.branch 
        })
    });

    if (!response.ok) {
        const error = await response.json();
        throw new Error(error.message);
    }
}

function fileToBase64(file) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
    });
}

function showAlert(containerId, message, type) {
    const container = document.getElementById(containerId);
    container.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
    setTimeout(() => container.innerHTML = '', 5000);
}

function viewCaseImages(index) {
    document.getElementById('caseSelect').value = index;
    selectedCase = currentData.cases[index];
    loadCaseImages();
    document.getElementById('caseSelect').scrollIntoView({ behavior: 'smooth' });
}
